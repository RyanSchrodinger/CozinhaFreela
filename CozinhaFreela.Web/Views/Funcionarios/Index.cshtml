@model IReadOnlyList<CozinhaFreela.Web.ViewModels.Funcionarios.FuncionarioListaViewModel>

@{
    ViewData["Title"] = "Funcionários";

    var totalFuncionarios = Model.Count;

    var totalAtivos =
        Model.Count(
            funcionario => funcionario.Ativo
        );

    var totalInativos =
        Model.Count(
            funcionario => !funcionario.Ativo
        );
}

<section class="pagina-administrativa pagina-funcionarios">
    <div class="container">
        @if (TempData["MensagemSucesso"] is string mensagemSucesso)
        {
            <div class="mensagem-sistema mensagem-sistema-sucesso"
                 role="alert">
                <span aria-hidden="true">✓</span>

                @mensagemSucesso
            </div>
        }

        @if (TempData["MensagemErro"] is string mensagemErro)
        {
            <div class="mensagem-sistema mensagem-sistema-erro"
                 role="alert">
                <span aria-hidden="true">!</span>

                @mensagemErro
            </div>
        }

        <header class="administracao-cabecalho">
            <div>
                <span class="secao-etiqueta">
                    Gestão da equipe
                </span>

                <h1>Funcionários</h1>

                <p>
                    Consulte os profissionais aprovados e
                    suas informações de cadastro.
                </p>
            </div>

            <div class="funcionarios-cabecalho-acoes">
                <a class="botao botao-verde"
                   asp-controller="Funcionarios"
                   asp-action="Pendentes">
                    Cadastros pendentes
                </a>

                <button class="botao botao-exportar"
                        type="button"
                        disabled
                        title="Disponível em breve">
                    Exportar todos
                </button>
            </div>
        </header>

        <div class="resumo-funcionarios">
            <article class="resumo-funcionario-card">
                <span>Total</span>

                <strong>
                    @totalFuncionarios
                </strong>

                <small>
                    Funcionários aprovados
                </small>
            </article>

            <article class="resumo-funcionario-card">
                <span>Ativos</span>

                <strong>
                    @totalAtivos
                </strong>

                <small>
                    Com acesso liberado
                </small>
            </article>

            <article class="resumo-funcionario-card">
                <span>Inativos</span>

                <strong>
                    @totalInativos
                </strong>

                <small>
                    Com acesso suspenso
                </small>
            </article>
        </div>

        @if (Model.Count == 0)
        {
            <div class="estado-vazio">
                <span class="estado-vazio-icone"
                      aria-hidden="true">
                    0
                </span>

                <h2>
                    Nenhum funcionário aprovado
                </h2>

                <p>
                    Os funcionários aparecerão aqui depois
                    que seus cadastros forem aprovados.
                </p>

                <a class="botao botao-verde"
                   asp-controller="Funcionarios"
                   asp-action="Pendentes">
                    Ver cadastros pendentes
                </a>
            </div>
        }
        else
        {
            <div class="lista-funcionarios">
                @foreach (var funcionario in Model)
                {
                    var inicial =
                        string.IsNullOrWhiteSpace(
                            funcionario.NomeCompleto
                        )
                            ? "F"
                            : funcionario
                                .NomeCompleto
                                .Trim()[0]
                                .ToString()
                                .ToUpperInvariant();

                    var classeSituacao =
                        funcionario.Ativo
                            ? "situacao-ativa"
                            : "situacao-inativa";

                    var textoSituacao =
                        funcionario.Ativo
                            ? "Ativo"
                            : "Inativo";

                    <article class="funcionario-card">
                        <div class="funcionario-card-identidade">
                            <span class="funcionario-card-avatar"
                                  aria-hidden="true">
                                @inicial
                            </span>

                            <div>
                                <h2>
                                    @funcionario.NomeCompleto
                                </h2>

                                <p>
                                    @funcionario.Funcao
                                </p>
                            </div>
                        </div>

                        <dl class="funcionario-card-dados">
                            <div>
                                <dt>Telefone</dt>

                                <dd>
                                    @funcionario.Telefone
                                </dd>
                            </div>

                            <div>
                                <dt>E-mail</dt>

                                <dd>
                                    @funcionario.Email
                                </dd>
                            </div>

                            <div>
                                <dt>Localização</dt>

                                <dd>
                                    @funcionario.Cidade —
                                    @funcionario.Estado
                                </dd>
                            </div>

                            <div>
                                <dt>Situação</dt>

                                <dd>
                                    <span class="funcionario-situacao @classeSituacao">
                                        @textoSituacao
                                    </span>
                                </dd>
                            </div>
                        </dl>

                        <div class="funcionario-card-acoes">
                            <a class="botao botao-verde"
                               asp-controller="Funcionarios"
                               asp-action="Detalhes"
                               asp-route-id="@funcionario.UsuarioId">
                                Ver informações
                            </a>

                            <a class="botao botao-exportar"
                               asp-controller="Funcionarios"
                               asp-action="ExportarPdf"
                               asp-route-id="@funcionario.UsuarioId">
                                Exportar PDF
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>