@model IReadOnlyCollection<
CozinhaFreela.Web.ViewModels.Funcionarios.FuncionarioPendenteViewModel
>

@{
    ViewData["Title"] = "Cadastros pendentes";
}

<section class="pagina-administrativa">
    <div class="container">
        @if (TempData["MensagemSucesso"] is string mensagemSucesso)
        {
            <div class="mensagem-sistema mensagem-sistema-sucesso"
                 role="status">
                <span aria-hidden="true">✓</span>
                @mensagemSucesso
            </div>
        }

        @if (TempData["MensagemErro"] is string mensagemErro)
        {
            <div class="mensagem-sistema mensagem-sistema-erro"
                 role="alert">
                <span aria-hidden="true">!</span>
                @mensagemErro
            </div>
        }
        <div class="administracao-cabecalho">
            <div>
                <span class="secao-etiqueta">
                    Gestão da equipe
                </span>

                <h1>Cadastros pendentes</h1>

                <p>
                    Consulte os novos cadastros antes de
                    definir a função e liberar o acesso.
                </p>
            </div>

            <div class="resumo-pendentes">
                <span>Aguardando análise</span>

                <strong>
                    @Model.Count
                </strong>
            </div>
        </div>

        @if (Model.Count == 0)
        {
            <div class="estado-vazio">
                <span class="estado-vazio-icone">
                    ✓
                </span>

                <h2>Nenhum cadastro pendente</h2>

                <p>
                    Todos os cadastros recebidos já foram
                    analisados.
                </p>

                <a class="botao botao-verde"
                   asp-controller="Home"
                   asp-action="Index">
                    Voltar para o início
                </a>
            </div>
        }
        else
        {
            <div class="tabela-pendentes-container">
                <div class="tabela-pendentes-cabecalho">
                    <div>
                        <strong>Novos funcionários</strong>

                        <span>
                            Ordenados pela data do cadastro
                        </span>
                    </div>

                    <span class="quantidade-registros">
                        @Model.Count
                        @(Model.Count == 1
                            ? "cadastro"
                            : "cadastros")
                    </span>
                </div>

                <div class="table-responsive">
                    <table class="tabela-pendentes">
                        <thead>
                            <tr>
                                <th>Funcionário</th>
                                <th>Contato</th>
                                <th>Localização</th>
                                <th>E-mail</th>
                                <th>Cadastro</th>
                                <th>
                                    <span class="visually-hidden">
                                        Ações
                                    </span>
                                </th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var funcionario in Model)
                            {
                                var inicial =
                                    funcionario.NomeCompleto
                                        .Trim()[0]
                                        .ToString()
                                        .ToUpperInvariant();

                                <tr>
                                    <td>
                                        <div class="funcionario-identificacao">
                                            <span class="funcionario-avatar">
                                                @inicial
                                            </span>

                                            <div>
                                                <strong>
                                                    @funcionario.NomeCompleto
                                                </strong>

                                                <span>
                                                    @funcionario.CpfMascarado
                                                </span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="tabela-informacao">
                                            <strong>
                                                @funcionario.Telefone
                                            </strong>

                                            <span>
                                                @funcionario.Email
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="tabela-informacao">
                                            <strong>
                                                @funcionario.Cidade
                                            </strong>

                                            <span>
                                                @funcionario.Estado
                                            </span>
                                        </div>
                                    </td>

                                    <td>
                                        @if (funcionario.EmailConfirmado)
                                        {
                                            <span class="status-email confirmado">
                                                Confirmado
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-email pendente">
                                                Não confirmado
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="tabela-informacao">
                                            <strong>
                                                @(funcionario.DataCadastro.ToString(
                                                    "dd/MM/yyyy"
                                                ))
                                            </strong>

                                            <span>
                                                Recebido
                                            </span>
                                        </div>
                                    </td>

                                    <td class="tabela-acoes">
                                        <a class="botao-analisar"
                                           asp-controller="Funcionarios"
                                           asp-action="Analisar"
                                           asp-route-id="@funcionario.UsuarioId">
                                            Analisar
                                        </a>

                                        @if (!funcionario.EmailConfirmado)
                                        {
                                            <div class="dropdown mt-2">
                                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle"
                                                        type="button"
                                                        data-bs-toggle="dropdown"
                                                        aria-expanded="false">
                                                    Opções do e-mail
                                                </button>

                                                <ul class="dropdown-menu dropdown-menu-end">
                                                    <li>
                                                        <form asp-action="ReenviarCodigo" method="post">
                                                            <input type="hidden" name="usuarioId" value="@funcionario.UsuarioId" />
                                                            <button type="submit" class="dropdown-item">
                                                                Reenviar código
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <button type="button"
                                                                class="dropdown-item"
                                                                data-bs-toggle="modal"
                                                                data-bs-target="#corrigirEmail-@funcionario.UsuarioId">
                                                            Corrigir e-mail
                                                        </button>
                                                    </li>
                                                    <li><hr class="dropdown-divider" /></li>
                                                    <li>
                                                        <form asp-action="ExcluirNaoConfirmado"
                                                              method="post"
                                                              onsubmit="return confirm('Excluir permanentemente este cadastro?');">
                                                            <input type="hidden" name="usuarioId" value="@funcionario.UsuarioId" />
                                                            <button type="submit" class="dropdown-item text-danger">
                                                                Excluir cadastro
                                                            </button>
                                                        </form>
                                                    </li>
                                                </ul>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @foreach (var funcionario in Model.Where(item => !item.EmailConfirmado))
            {
                <div class="modal fade"
                     id="corrigirEmail-@funcionario.UsuarioId"
                     tabindex="-1"
                     aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-action="CorrigirEmail" method="post">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5">Corrigir e-mail</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                                </div>
                                <div class="modal-body">
                                    <p class="text-muted">
                                        @funcionario.NomeCompleto
                                    </p>
                                    <input type="hidden" name="usuarioId" value="@funcionario.UsuarioId" />
                                    <label class="form-label" for="email-@funcionario.UsuarioId">Novo e-mail</label>
                                    <input id="email-@funcionario.UsuarioId"
                                           type="email"
                                           name="novoEmail"
                                           value="@funcionario.Email"
                                           class="form-control"
                                           required />
                                    <div class="form-text">
                                        Um novo código será enviado e o prazo de 24 horas começará novamente.
                                    </div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                                    <button type="submit" class="btn btn-primary">Salvar e enviar código</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</section>
