@{
    ViewData["Title"] = "Sabores, música e natureza";
}

@if (TempData["CadastroCancelado"] is string cadastroCancelado)
{
    <div class="container pt-3">
        <div class="alert alert-success mb-0" role="status">
            @cadastroCancelado
        </div>
    </div>
}

<section id="inicio" class="hero-fazenda">
    <div class="hero-sobreposicao"></div>

    <div class="container hero-container">
        <div class="hero-conteudo">
            <span class="hero-etiqueta">
                Restaurante • Natureza • Música
            </span>

            <h1 class="hero-titulo">
                Sabores e momentos
                <span>para guardar na memória.</span>
            </h1>

            <p class="hero-descricao">
                Um lugar acolhedor para aproveitar boa comida,
                música e natureza ao lado de quem você gosta.
            </p>

            <div class="hero-acoes">
                <a class="botao botao-dourado"
                   href="#experiencia">
                    Conheça a experiência
                </a>

                <a class="botao botao-transparente"
                   href="#visite">
                    Como chegar
                </a>
            </div>
        </div>

        <a class="indicador-rolagem"
           href="#experiencia"
           aria-label="Ir para a próxima seção">
            <span>Descubra</span>
            <span class="indicador-linha"></span>
        </a>
    </div>
</section>

<section id="experiencia"
         class="secao secao-experiencia">
    <div class="container">
        <div class="experiencia-grid">
            <div class="experiencia-introducao">
                <span class="secao-etiqueta">
                    Viva a experiência
                </span>

                <h2>
                    Muito além de uma refeição
                </h2>
            </div>

            <div class="experiencia-texto">
                <p>
                    Um ambiente inspirado na vida no campo,
                    preparado para reunir famílias e amigos
                    em torno de sabores especiais.
                </p>

                <p>
                    Aqui, o almoço ganha a companhia da
                    natureza, da música e de bons momentos
                    compartilhados.
                </p>
            </div>
        </div>

        <div class="destaques-grid">
            <article class="destaque-card">
                <span class="destaque-numero">01</span>

                <h3>Comida de verdade</h3>

                <p>
                    Sabores preparados para proporcionar
                    aquele almoço acolhedor de fim de semana.
                </p>
            </article>

            <article class="destaque-card destaque-card-escuro">
                <span class="destaque-numero">02</span>

                <h3>Natureza ao redor</h3>

                <p>
                    Um espaço para desacelerar e aproveitar
                    o dia longe da correria.
                </p>
            </article>

            <article class="destaque-card">
                <span class="destaque-numero">03</span>

                <h3>Música e encontros</h3>

                <p>
                    Boa música completa a experiência e
                    deixa cada encontro mais especial.
                </p>
            </article>
        </div>
    </div>
</section>

<section id="sabores" class="secao secao-sabores">
    <div class="container">
        <div class="sabores-grid">
            <div class="sabores-visual">
                <div class="sabores-moldura">
                    <span class="sabores-palavra">
                        SABOR
                    </span>

                    <div class="sabores-detalhe">
                        <span>Feito para compartilhar</span>
                    </div>
                </div>
            </div>

            <div class="sabores-conteudo">
                <span class="secao-etiqueta">
                    Sabores da fazenda
                </span>

                <h2>
                    Uma mesa preparada para reunir pessoas
                </h2>

                <p>
                    Variedade, cuidado e aquele sabor que
                    combina com dias tranquilos no campo.
                    Uma experiência pensada para ser
                    compartilhada.
                </p>

                <ul class="lista-diferenciais">
                    <li>
                        <span></span>
                        Buffet variado
                    </li>

                    <li>
                        <span></span>
                        Ambiente familiar
                    </li>

                    <li>
                        <span></span>
                        Experiência de fim de semana
                    </li>
                </ul>

                <a class="link-elegante"
                   href="#visite">
                    Planeje sua visita
                    <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section id="momentos" class="secao secao-momentos">
    <div class="container">
        <div class="secao-cabecalho centralizado">
            <span class="secao-etiqueta secao-etiqueta-clara">
                Bons momentos
            </span>

            <h2>
                Um dia para aproveitar sem pressa
            </h2>

            <p>
                Comida, natureza e música reunidas em uma
                experiência acolhedora.
            </p>
        </div>

        <div class="momentos-grid">
            <article class="momento-card">
                <span class="momento-icone">01</span>
                <h3>Almoço em família</h3>

                <p>
                    Um espaço convidativo para reunir
                    diferentes gerações.
                </p>
            </article>

            <article class="momento-card">
                <span class="momento-icone">02</span>
                <h3>Música ao vivo</h3>

                <p>
                    Apresentações que ajudam a criar a
                    atmosfera especial do lugar.
                </p>
            </article>

            <article class="momento-card">
                <span class="momento-icone">03</span>
                <h3>Contato com a natureza</h3>

                <p>
                    Um cenário tranquilo para descansar
                    e aproveitar o fim de semana.
                </p>
            </article>
        </div>
    </div>
</section>

<section id="visite" class="secao secao-visite">
    <div class="container">
        <div class="visite-card">
            <div class="visite-conteudo">
                <span class="secao-etiqueta">
                    Planeje seu dia
                </span>

                <h2>
                    Venha viver essa experiência
                </h2>

                <p>
                    Funcionamento aos sábados, domingos
                    e feriados.
                </p>

                <address>
                    Estrada do Bom Tempo, 463<br />
                    Franco da Rocha — SP
                </address>
            </div>

            <div class="visite-acoes">
                <a class="botao botao-verde"
                   href="https://www.google.com/maps/search/?api=1&query=Estrada+do+Bom+Tempo+463+Franco+da+Rocha+SP"
                   target="_blank"
                   rel="noopener noreferrer">
                    Abrir no mapa
                </a>

                <a class="link-instagram"
                   href="https://www.instagram.com/fazendatresleoes/"
                   target="_blank"
                   rel="noopener noreferrer">
                    Acompanhar no Instagram
                    <span aria-hidden="true">↗</span>
                </a>
            </div>
        </div>
    </div>
</section>

<section class="area-funcionario">
    <div class="container">
        <div class="area-funcionario-conteudo">
            <div>
                <span class="area-funcionario-etiqueta">
                    Acesso interno
                </span>

                <h2>Você faz parte da equipe?</h2>

                <p>
                    Acesse suas escalas, disponibilidades,
                    tarefas e informações de trabalho.
                </p>
            </div>

            <div class="area-funcionario-acoes">
                <a class="botao botao-claro"
                    <a
                        class="botao botao-claro"
                        asp-controller="Conta"
                        asp-action="Login"
                        >
                            Entrar
                        </a>

                <a class="botao botao-contorno-claro"
                   asp-controller="Conta"
                   asp-action="Cadastro">
                    Fazer cadastro
                </a>
            </div>
        </div>
    </div>
</section>
