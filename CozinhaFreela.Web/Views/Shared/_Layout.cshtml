<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Organização de equipes, escalas, cardápios e tarefas para cozinhas profissionais." />

    <title>@ViewData["Title"] - CozinhaFreela</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CozinhaFreela.Web.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header class="cabecalho">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand marca"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="marca-icone">CF</span>
                    <span>CozinhaFreela</span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navegacaoPrincipal"
                        aria-controls="navegacaoPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu de navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="navegacaoPrincipal"
                     class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="inicio">
                                Início
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="como-funciona">
                                Como funciona
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="recursos">
                                Recursos
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    Olá, @User.Identity.Name
                                </span>
                            </li>

                            @if (User.IsInRole("ChefeCozinha"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link"
                                       href="#">
                                        Funcionários
                                    </a>
                                </li>
                            }
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-outline-success"
                                   asp-controller="Conta"
                                   asp-action="Cadastro">
                                    Criar conta
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-success"
                                   href="#"
                                   aria-disabled="true"
                                   title="O login será implementado na próxima etapa">
                                    Entrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="rodape">
        <div class="container">
            <div class="rodape-conteudo">
                <div>
                    <strong>CozinhaFreela</strong>

                    <p>
                        Organização simples para equipes de cozinha.
                    </p>
                </div>

                <p>
                    &copy; @DateTime.Now.Year CozinhaFreela
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
</body>
</html>