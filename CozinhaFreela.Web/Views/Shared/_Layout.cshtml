@using CozinhaFreela.Domain.Usuarios
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager

@{
    ApplicationUser? usuarioAtual = null;

    var nomeUsuario = "Usuário";
    var inicialUsuario = "U";
    var perfilUsuario = "Funcionário";

    if (User.Identity?.IsAuthenticated == true)
    {
        usuarioAtual =
            await UserManager.GetUserAsync(User);

        if (usuarioAtual is not null &&
            !string.IsNullOrWhiteSpace(
                usuarioAtual.NomeCompleto))
        {
            nomeUsuario =
                usuarioAtual.NomeCompleto;

            inicialUsuario =
                nomeUsuario
                    .Trim()[0]
                    .ToString()
                    .ToUpperInvariant();
        }

        if (User.IsInRole(RolesSistema.Chefe))
        {
            perfilUsuario = "Chefe de cozinha";
        }
    }
}

<!DOCTYPE html>

<html lang="pt-BR">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="Sabores, música e natureza para viver bons momentos." />

    <title>
        @ViewData["Title"] - CozinhaFreela
    </title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="icon" type="image/png" href="favicon.png">
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CozinhaFreela.Web.styles.css"
          asp-append-version="true" />
</head>

<body>
    <header class="cabecalho">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand marca"
                   asp-controller="Home"
                   asp-action="Index">
                    <span class="marca-icone">
                        CF
                    </span>

                    <span>
                        CozinhaFreela
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navegacaoPrincipal"
                        aria-controls="navegacaoPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menu de navegação">
                    <span class="icone-menu"
                          aria-hidden="true">
                        <span></span>
                        <span></span>
                        <span></span>
                    </span>
                </button>

                <div id="navegacaoPrincipal"
                     class="collapse navbar-collapse">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="inicio">
                                Início
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="experiencia">
                                Experiência
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="sabores">
                                Sabores
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index"
                               asp-fragment="visite">
                                Visite
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown menu-usuario">
                                <button class="botao-menu-usuario dropdown-toggle"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false"
                                        aria-label="Abrir menu do usuário">
                                    <span class="avatar-usuario">
                                        @inicialUsuario
                                    </span>

                                    <span class="usuario-resumo">
                                        <strong>
                                            @nomeUsuario.Split(' ')[0]
                                        </strong>

                                        <small>
                                            @perfilUsuario
                                        </small>
                                    </span>
                                </button>

                                <div class="dropdown-menu dropdown-menu-end menu-usuario-dropdown">
                                    <div class="menu-usuario-cabecalho">
                                        <span class="avatar-usuario avatar-usuario-grande">
                                            @inicialUsuario
                                        </span>

                                        <div>
                                            <strong>
                                                @nomeUsuario
                                            </strong>

                                            <span>
                                                @perfilUsuario
                                            </span>
                                        </div>
                                    </div>

                                    <div class="dropdown-divider"></div>

                                    @if (User.IsInRole(
                                        RolesSistema.Chefe))
                                    {
                                       <a class="dropdown-item"
                                           asp-controller="Funcionarios"
                                           asp-action="Index">
                                            Funcionários
                                        </a>

                                        <a class="dropdown-item"
                                           asp-controller="Funcionarios"
                                           asp-action="Pendentes">
                                            Cadastros pendentes
                                        </a>

                                        <span class="dropdown-item menu-item-indisponivel">
                                            Escalas

                                            <small>
                                                Em breve
                                            </small>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="dropdown-item menu-item-indisponivel">
                                            Minha disponibilidade

                                            <small>
                                                Em breve
                                            </small>
                                        </span>

                                        <span class="dropdown-item menu-item-indisponivel">
                                            Minha escala

                                            <small>
                                                Em breve
                                            </small>
                                        </span>

                                        <span class="dropdown-item menu-item-indisponivel">
                                            Minhas tarefas

                                            <small>
                                                Em breve
                                            </small>
                                        </span>
                                    }

                                    <div class="dropdown-divider"></div>

                                    <span class="dropdown-item menu-item-indisponivel">
                                        Meu perfil

                                        <small>
                                            Em breve
                                        </small>
                                    </span>

                                    <form asp-controller="Conta"
                                          asp-action="Logout"
                                          method="post">
                                        <button class="dropdown-item botao-sair"
                                                type="submit">
                                            Sair da conta
                                        </button>
                                    </form>
                                </div>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-outline-success"
                                   asp-controller="Conta"
                                   asp-action="Cadastro">
                                    Criar conta
                                </a>
                            </li>

                            <li class="nav-item ms-lg-2">
                                <a class="btn btn-success"
                                   asp-controller="Conta"
                                   asp-action="Login">
                                    Entrar
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="rodape">
        <div class="container">
            <div class="rodape-conteudo">
                <div>
                    <strong>
                        CozinhaFreela
                    </strong>

                    <p>
                        Organização simples para equipes
                        de cozinha.
                    </p>
                </div>

                <p>
                    &copy; @DateTime.Now.Year CozinhaFreela
                </p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync(
        "Scripts",
        required: false
    )
</body>
</html>