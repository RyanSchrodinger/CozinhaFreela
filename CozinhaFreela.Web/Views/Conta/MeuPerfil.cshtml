@model CozinhaFreela.Web.ViewModels.Conta.MeuPerfilViewModel

@{
    ViewData["Title"] = "Meu perfil";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="mb-4">
                <span class="secao-etiqueta">Minha conta</span>
                <h1 class="h2">Meu perfil</h1>
                <p class="text-muted">
                    Mantenha suas informações pessoais e de contato atualizadas.
                </p>
            </div>

            @if (TempData["PerfilAtualizado"] is string mensagem)
            {
                <div class="alert alert-success" role="status">
                    @mensagem
                </div>
            }

            <form asp-action="MeuPerfil" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-4">Dados pessoais</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="NomeCompleto" class="form-label"></label>
                                <input asp-for="NomeCompleto" class="form-control" autocomplete="name" />
                                <span asp-validation-for="NomeCompleto" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Cpf" class="form-label"></label>
                                <input asp-for="Cpf" class="form-control" inputmode="numeric" data-mask="cpf" maxlength="14" />
                                <span asp-validation-for="Cpf" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="DataNascimento" class="form-label"></label>
                                <input asp-for="DataNascimento" class="form-control" type="text" inputmode="numeric" data-mask="date" maxlength="10" placeholder="dd/mm/aaaa" autocomplete="bday" />
                                <span asp-validation-for="DataNascimento" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Telefone" class="form-label"></label>
                                <input asp-for="Telefone" class="form-control" inputmode="tel" data-mask="phone" maxlength="15" autocomplete="tel" />
                                <span asp-validation-for="Telefone" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label"></label>
                                <input asp-for="Email" class="form-control" type="email" autocomplete="email" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Nacionalidade" class="form-label"></label>
                                <input asp-for="Nacionalidade" class="form-control" />
                                <span asp-validation-for="Nacionalidade" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EstadoCivil" class="form-label"></label>
                                <select asp-for="EstadoCivil" class="form-select">
                                    <option value="">Selecione</option>
                                    <option>Solteiro(a)</option>
                                    <option>Casado(a)</option>
                                    <option>Divorciado(a)</option>
                                    <option>Viúvo(a)</option>
                                    <option>União estável</option>
                                </select>
                                <span asp-validation-for="EstadoCivil" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-4">Endereço</h2>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label asp-for="Cep" class="form-label"></label>
                                <input asp-for="Cep" class="form-control" inputmode="numeric" data-mask="cep" maxlength="9" autocomplete="postal-code" />
                                <span asp-validation-for="Cep" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Rua" class="form-label"></label>
                                <input asp-for="Rua" class="form-control" autocomplete="address-line1" />
                                <span asp-validation-for="Rua" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Numero" class="form-label"></label>
                                <input asp-for="Numero" class="form-control" />
                                <span asp-validation-for="Numero" class="text-danger"></span>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Complemento" class="form-label"></label>
                                <input asp-for="Complemento" class="form-control" />
                                <span asp-validation-for="Complemento" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Bairro" class="form-label"></label>
                                <input asp-for="Bairro" class="form-control" />
                                <span asp-validation-for="Bairro" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="Cidade" class="form-label"></label>
                                <input asp-for="Cidade" class="form-control" />
                                <span asp-validation-for="Cidade" class="text-danger"></span>
                            </div>
                            <div class="col-md-2">
                                <label asp-for="Estado" class="form-label"></label>
                                <input asp-for="Estado" class="form-control text-uppercase" maxlength="2" />
                                <span asp-validation-for="Estado" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-body p-4">
                        <h2 class="h5 mb-4">Contato de emergência</h2>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="ContatoEmergenciaNome" class="form-label"></label>
                                <input asp-for="ContatoEmergenciaNome" class="form-control" />
                                <span asp-validation-for="ContatoEmergenciaNome" class="text-danger"></span>
                            </div>
                            <div class="col-md-5">
                                <label asp-for="ContatoEmergenciaTelefone" class="form-label"></label>
                                <input asp-for="ContatoEmergenciaTelefone" class="form-control" inputmode="tel" data-mask="phone" maxlength="15" />
                                <span asp-validation-for="ContatoEmergenciaTelefone" class="text-danger"></span>
                            </div>
                            <div class="col-12">
                                <label asp-for="Observacoes" class="form-label"></label>
                                <textarea asp-for="Observacoes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Observacoes" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card border-warning mb-4">
                    <div class="card-body p-4">
                        <h2 class="h5">Confirmação de segurança</h2>
                        <p class="text-muted small">
                            A senha atual é obrigatória somente para alterar CPF ou e-mail. Se o e-mail mudar, enviaremos um novo código de confirmação.
                        </p>
                        <label asp-for="SenhaAtual" class="form-label"></label>
                        <input asp-for="SenhaAtual" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="SenhaAtual" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-grid d-md-flex justify-content-md-end gap-2">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                    <button type="submit" class="btn btn-primary btn-lg">Salvar alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
